# PosternProxy Docker configuration
# Copy this file to .env and fill in the values.

# Required: JWT signing secret (generate with: openssl rand -hex 32)
POSTERNPROXY_JWT_SECRET=

# Optional: advertised WebSocket URL for agents to connect back to the controller.
# Set this if you plan to use multi-server mode.
# POSTERNPROXY_CONTROLLER_URL=http://your-controller-ip:81

# Optional: override default admin credentials (first boot only).
# If not set, a random password is generated and printed to the logs.
# POSTERNPROXY_ADMIN_EMAIL=admin@posternproxy.local
# POSTERNPROXY_ADMIN_PASSWORD=
