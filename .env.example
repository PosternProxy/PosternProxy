# Copy this file to .env and fill in the values before running docker compose up.

# Required: generate with: openssl rand -hex 32
# This key encrypts stored SSH credentials — keep it stable across restarts.
POSTERNPROXY_JWT_SECRET=

# WebSocket URL that remote agents use to connect back to this controller.
# Set to your public hostname/IP (ws:// or wss:// for TLS).
POSTERNPROXY_CONTROLLER_URL=wss://your-domain:81

# Admin account created on first boot (change the password immediately after login).
POSTERNPROXY_ADMIN_EMAIL=admin@example.com
POSTERNPROXY_ADMIN_PASSWORD=changeme_immediately
