# Normalize line endings. Without this, core.autocrlf=true on Windows checks
# out shell scripts with CRLF, which breaks them when run on Linux servers
# (e.g. `set -euo pipefail\r` -> "invalid option name").

# Default: let git normalize text files to LF in the repo.
* text=auto

# Files that MUST stay LF regardless of platform (executed on Linux).
*.sh    text eol=lf
*.bash  text eol=lf

# Windows-only scripts stay CRLF.
*.ps1   text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf
